APP_ENV=development
BIND_ADDR=127.0.0.1:3000
RUST_LOG=eap_tls_cert_portal=debug

STEP_CA_URL=https://step-ca.example.internal
STEP_CA_ROOT=/absolute/path/to/root_ca.crt
STEP_CA_PROVISIONER=axum-eap
STEP_CA_PROVISIONER_PASSWORD_FILE=/absolute/path/to/provisioner-password
STEP_BINARY=step

VPN_STEP_CA_URL=https://vpn-step-ca.example.internal
VPN_STEP_CA_ROOT=/absolute/path/to/vpn_root_ca.crt
VPN_STEP_CA_PROVISIONER=axum-vpn
VPN_STEP_CA_PROVISIONER_PASSWORD_FILE=/absolute/path/to/vpn-provisioner-password

# Docker Compose가 호스트에서 읽어 컨테이너에 read-only로 전달할 파일입니다.
STEP_CA_ROOT_HOST_PATH=/absolute/path/to/root_ca.crt
STEP_CA_PROVISIONER_PASSWORD_HOST_PATH=/absolute/path/to/provisioner-password
VPN_STEP_CA_ROOT_HOST_PATH=/absolute/path/to/vpn_root_ca.crt
VPN_STEP_CA_PROVISIONER_PASSWORD_HOST_PATH=/absolute/path/to/vpn-provisioner-password
