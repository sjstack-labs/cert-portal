APP_ENV=production
BIND_ADDR=0.0.0.0:3000
RUST_LOG=eap_tls_cert_portal=info

STEP_CA_URL=https://step-ca.example.internal
STEP_CA_PROVISIONER=axum-eap
CF_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
CF_ACCESS_AUDIENCE=replace-with-application-aud-tag

# docker compose가 호스트에서 읽어 컨테이너에 read-only로 전달할 파일입니다.
STEP_CA_ROOT_HOST_PATH=/etc/axum-pki/root_ca.crt
STEP_CA_PROVISIONER_PASSWORD_HOST_PATH=/etc/axum-pki/axum-eap-password
